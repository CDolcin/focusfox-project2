rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private data: only the signed-in owner can touch their own subtree.
    // hlc layout is "<15-digit wall ms>.<counter>.<deviceId>"; the wall part must be within +/-24h of server time
    // so a device with a wildly wrong clock cannot write a stamp that wins every future conflict.
    match /users/{uid}/{coll}/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == id
        && request.resource.data.hlc is string
        && request.resource.data.deleted is bool
        && request.resource.data.serverUpdatedAt == request.time
        && int(request.resource.data.hlc.split('[.]')[0]) < request.time.toMillis() + 86400000
        && int(request.resource.data.hlc.split('[.]')[0]) > request.time.toMillis() - 31536000000;
      allow delete: if false;   // deletes are tombstone writes, never hard deletes
    }

    match /friendOwners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code']) && request.resource.data.code.matches('[A-Z2-9]{6}');
      allow update: if request.auth != null && request.auth.uid == uid && request.resource.data == resource.data;
    }
    match /friendProfiles/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && (!exists(/databases/$(database)/documents/friendProfiles/$(code)) || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'code', 'name', 'streak', 'day', 'updatedAtMs', 'serverUpdatedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.code == code
        && getAfter(/databases/$(database)/documents/friendOwners/$(request.auth.uid)).data.code == code
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= 100000
        && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.serverUpdatedAt == request.time;
    }

    // Shared decks: the 6-character code is the capability. Fetch by id only; listing is not allowed.
    match /sharedDecks/{code} {
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/sharedDecks/$(code)) || resource.data.revoked == false || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.version == 1;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == code
        && request.resource.data.version >= resource.data.version;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
