rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Task images and voice recordings: private to the owner, size-limited.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
